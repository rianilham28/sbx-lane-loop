# Project environment, auto-reloaded after each commit by .git/hooks/post-commit.
# No secret is stored here: GH_TOKEN is resolved from the gh keyring on demand,
# matching the README rule that tokens are read per call, never written to disk.
export SBX_LANE_LOOP_ROOT="$PWD"

# One identity for author and committer: rianilham28, matching the commits in
# his existing repos. Set as env vars rather than git config so a clone in
# another project inherits them without a per-repo config write.
export GIT_AUTHOR_NAME="rianilham28"
export GIT_AUTHOR_EMAIL="292493135+rianilham28@users.noreply.github.com"
export GIT_COMMITTER_NAME="rianilham28"
export GIT_COMMITTER_EMAIL="292493135+rianilham28@users.noreply.github.com"

# Resolve the rianilham28 token at load; leave any inherited value untouched if
# gh is missing or has no such account, so an empty GH_TOKEN never breaks auth.
if [ -z "${GH_TOKEN:-}" ] && command -v gh >/dev/null 2>&1; then
  _gh_token="$(gh auth token -u rianilham28 2>/dev/null)" || _gh_token=""
  if [ -n "$_gh_token" ]; then
    export GH_TOKEN="$_gh_token"
  fi
  unset _gh_token
fi
